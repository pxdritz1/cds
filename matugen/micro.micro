color-link default "{{ colors.on_surface.default.hex }}"
color-link comment "{{ colors.on_surface_variant.default.hex }}"
color-link selection "{{ colors.on_primary_container.default.hex }},{{ colors.primary_container.default.hex }}"
color-link hlsearch "{{ colors.on_secondary.default.hex }},{{ colors.secondary.default.hex }}"
color-link identifier "{{ colors.primary.default.hex }}"
color-link identifier.class "{{ colors.primary.default.hex }}"
color-link identifier.var "{{ colors.on_surface.default.hex }}"
color-link constant "{{ colors.tertiary.default.hex }}"
color-link constant.number "{{ colors.secondary.default.hex }}"
color-link constant.string "{{ colors.tertiary.default.hex }}"
color-link symbol "{{ colors.on_surface.default.hex }}"
color-link symbol.brackets "{{ colors.on_surface_variant.default.hex }}"
color-link type "{{ colors.primary.default.hex }}"
color-link type.keyword "{{ colors.secondary.default.hex }}"
color-link special "{{ colors.tertiary.default.hex }}"
color-link statement "{{ colors.primary.default.hex }}"
color-link preproc "{{ colors.secondary.default.hex }}"
color-link error "bold {{ colors.error.default.hex }}"
color-link todo "bold {{ colors.secondary.default.hex }}"
color-link diff-added "{{ colors.tertiary.default.hex }}"
color-link diff-modified "{{ colors.secondary.default.hex }}"
color-link diff-deleted "{{ colors.error.default.hex }}"
color-link statusline "{{ colors.on_surface.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar "{{ colors.on_surface.default.hex }},{{ colors.surface_container.default.hex }}"
color-link indent-char "{{ colors.outline_variant.default.hex }}"
color-link line-number "{{ colors.on_surface_variant.default.hex }}"
color-link current-line-number "{{ colors.primary.default.hex }}"
color-link cursor-line "{{ colors.on_surface.default.hex }},{{ colors.surface_container_low.default.hex }}"
